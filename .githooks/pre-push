#!/bin/sh
# Block direct pushes to main (including deleting it). Use a feature branch and a pull request instead.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a feature branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
